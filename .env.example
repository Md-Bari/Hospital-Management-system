# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123!
POSTGRES_DB=HospitalMS_Db
POSTGRES_PORT=5432

# Database Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=HospitalMS_Db;Username=postgres;Password=postgres123!;Include Error Detail=true

# Redis Configuration
ConnectionStrings__Redis=localhost:6379

# JWT Settings
JwtSettings__Secret=HospitalMS_SuperSecretKeyForJWTAuth2026EnterpriseGrade_MustBeAtLeast32BytesLong!
JwtSettings__Issuer=HospitalMS.API
JwtSettings__Audience=HospitalMS.Web
JwtSettings__AccessTokenExpirationMinutes=15
JwtSettings__RefreshTokenExpirationDays=7

# Default Admin Account
AdminSeed__Email=admin@hospitalms.com
AdminSeed__Password=Admin@123456
AdminSeed__FullName=System Super Administrator

